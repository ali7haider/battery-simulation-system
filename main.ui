                               <property name="styleSheet">
                                <string notr="true">QPushButton {
  background-color: green; /* Medium Purple (as seen in the image) */
  color: white;
  border: none;
  padding: 6px 12px; /* Adjust padding as needed */
  border-radius: 4px; /* Slightly rounded corners */

QLineEdit {
    border-radius: 5px;
    border: 1px solid gray;
    padding-left: 5px;
    selection-color: #fff;
    selection-background-color: #1159A8;
    font-family: Calibri;
color:black

}

QLineEdit:hover {
    border: 2px solid gray;
}

QLineEdit:focus {
    border: 2px solid gray;
    background-color: #FAFAFC;
}
QComboBox {
    border-radius: 5px;
    border: 1px solid gray;
    padding: 5px;
    padding-left: 10px;
    color: black;
}

QComboBox:hover {
    border: 1px solid gray;
}

QComboBox::drop-down {
    subcontrol-origin: padding;
    subcontrol-position: top right;
    width: 25px; 
    border-left-width: 3px;
    border-left-color: rgba(39, 44, 54, 150);
    border-left-style: solid;
    border-top-right-radius: 3px;
    border-bottom-right-radius: 3px;    
    background: white; /* Ensure the dropdown has a white background */
    background-image: url(:/icons/images/icons/icons8-arrow-down-20.png);
    background-position: center;
    background-repeat: no-repeat;
}

QComboBox QAbstractItemView {
    background: white; /* Ensure dropdown list has a white background */
    color: black;
    padding: 10px;
    selection-background-color: #345CBF;
}




